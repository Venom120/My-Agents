{
  "$schema": "https://opencode.ai/config.json",
  // Loads agents AND skills directly from the GitHub repo — no local clone needed.
  // The plugin registers both from the repo's agents/ and skills/ folders.
  // Adjust the owner/branch if you forked or renamed the repo.
  "plugin": [
    "my-agents@git+https://github.com/Venom120/My-Agents.git#main"
  ]
}
