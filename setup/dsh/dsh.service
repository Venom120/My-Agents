# /etc/systemd/system/dsh.service
[Unit]
Description=DeepSeek Harness Web
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/root/.dsh

[Service]
Type=simple
User=root
WorkingDirectory=/root/.dsh

Environment=HOME=/root
Environment=DSH_HOME=/root/.dsh
Environment=NODE_OPTIONS=--max-old-space-size=8192

# Make .bashrc the source of truth for Bash environments
Environment=BASH_ENV=/root/.bashrc

# Start through Bash so .bashrc is loaded for the service itself
ExecStart=/bin/bash -c 'exec /usr/bin/env dsh web --no-open'

Restart=on-failure
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
