[Unit]
Description=DeepSeek Harness Web
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/root/.dsh

[Service]
Type=simple
User=root
WorkingDirectory=/root/.dsh

Environment=HOME=/root
Environment=DSH_HOME=/root/.dsh
Environment=NODE_OPTIONS=--max-old-space-size=8192

# pyenv
Environment=PYENV_ROOT=/root/.pyenv

# Linux-only PATH.
# pyenv shims come first so Python resolves through pyenv.
Environment="PATH=/root/.pyenv/shims:/root/.pyenv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Load the bash configuration for non-interactive bash shells.
# The .bashrc must not recursively initialize pyenv through BASH_ENV.
Environment=BASH_ENV=/root/.bashrc

ExecStart=/usr/bin/env dsh web --no-open

Restart=on-failure
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target