# /etc/systemd/system/omniroute.service
[Unit]
Description=OmniRoute AI Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root

# Service-specific environment
Environment=HOME=/root

# .bashrc is the single source of truth
Environment=BASH_ENV=/root/.bashrc

# Start through Bash so the service gets the same environment
# as other services using .bashrc.
ExecStart=/bin/bash -c 'exec /usr/bin/env omniroute'

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
