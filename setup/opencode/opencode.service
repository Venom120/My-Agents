# /etc/systemd/system/opencode.service
[Unit]
Description=OpenCode Web Server
Requires=omniroute.service
After=omniroute.service

[Service]
Type=simple
User=root
WorkingDirectory=/root

# Service-specific environment
Environment=HOME=/root

# Make .bashrc the source of truth for Bash environments
Environment=BASH_ENV=/root/.bashrc

# Prevent GUI/browser launching
Environment=DISPLAY=
Environment=WAYLAND_DISPLAY=
Environment=BROWSER=
Environment=OPEN=

# Start through Bash so .bashrc is loaded for the service itself
ExecStart=/bin/bash -c 'exec /root/.opencode/bin/opencode web --hostname 0.0.0.0 --port 4096'

# Hide Windows filesystem from this service
InaccessiblePaths=/mnt/c/Windows/System32/WindowsPowerShell

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
