# /etc/systemd/system/opencode.service
[Unit]
Description=OpenCode Web Server
Requires=omniroute.service
After=omniroute.service

[Service]
Type=simple
User=root
WorkingDirectory=/root

Environment=DISPLAY=
Environment=WAYLAND_DISPLAY=
Environment=BROWSER=
Environment=OPEN=
Environment=HOME=/root

# OpenCode environment
Environment=OPENCODE_ENABLE_EXA=1
EnvironmentFile=/etc/opencode/opencode.env

# OmniRoute environment
EnvironmentFile=/etc/omniroute/omniroute.env

# pyenv
Environment=PYENV_ROOT=/root/.pyenv

# Linux-only PATH.
# pyenv shims come first so Python resolves through pyenv.
Environment="PATH=/root/.pyenv/shims:/root/.pyenv/bin:/root/.opencode/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Hide Windows filesystem from this service.
InaccessiblePaths=/mnt/c/Windows/System32/WindowsPowerShell

ExecStart=/root/.opencode/bin/opencode web --hostname 0.0.0.0 --port 4096

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
